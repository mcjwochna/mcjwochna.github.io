---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { getImage } from 'astro:assets';
import { SITE } from '../data/site';
import portrait from '../assets/portrait.png';
import { THEME_INIT_SCRIPT } from '../scripts/theme-init.mjs';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} | Data Engineer & BI Developer`,
  description = 'Specializing in ETL/ELT pipelines, data modeling, and Power BI dashboards. Microsoft Fabric | Azure Synapse | SQL Server.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImage = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, SITE.url);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.schema.jobTitle,
  url: SITE.url,
  sameAs: [SITE.social.linkedin.url, SITE.social.github.url],
  knowsAbout: SITE.schema.skills,
  email: SITE.contact.email,
  telephone: SITE.contact.phone,
  address: {
    '@type': 'PostalAddress',
    addressCountry: SITE.schema.addressCountry,
  },
};
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="preconnect" href="https://in2data.pl" />
    <link rel="dns-prefetch" href="https://app.powerbi.com" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#10b981" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={`${SITE.name} - Data Engineer Portfolio`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <script is:inline set:html={THEME_INIT_SCRIPT} />
</head>
<body class="bg-bg-primary text-text-primary antialiased overflow-x-hidden flex flex-col min-h-screen transition-colors duration-300 selection:bg-accent-primary selection:text-white">

    <Navbar />

    <main class="grow">
        <slot />
    </main>
</body>
</html>
