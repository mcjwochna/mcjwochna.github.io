---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
    image: ImageMetadata;
    alt: string;
    overlayClass: string;
    isLcp?: boolean;
}

const { image, alt, overlayClass, isLcp = false } = Astro.props;
---
<div class="absolute inset-0 lg:w-[65%] lg:left-[35%] lg:[clip-path:polygon(12%_0,100%_0,100%_100%,0%_100%)]">
    <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 1024px) 65vw, 100vw"
        loading={isLcp ? 'eager' : 'lazy'}
        fetchpriority={isLcp ? 'high' : 'auto'}
        class="absolute inset-0 h-full w-full object-cover object-center lg:object-right"
    />
    <div class:list={['absolute inset-0', overlayClass]}></div>
</div>
